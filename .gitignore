# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out/ — NORMALDE göz ardı edilir, ama Hostinger paylaşımlı hosting Git
# dağıtımı derleme yapmadığı için hazır statik çıktıyı BİLEREK depoya
# ekliyoruz (bkz. next.config.ts açıklaması). Bu satır kasıtlı olarak YOK.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# yerel Claude Code oturum ayarları / geçici loglar
.claude/settings.local.json
tunnel.log
