// Portföy sitesi veritabanı şeması (Neon PostgreSQL).
// Admin panelinden yönetilen içerikler burada tutulur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin işlem geçmişi (log kayıtları)
model ActivityLog {
  id        String   @id @default(cuid())
  action    String   // "Proje eklendi", "Hizmet güncellendi"...
  detail    String?  // ilgili öğe adı
  kind      String   @default("info") // info | create | update | delete
  createdAt DateTime @default(now())
}

// Admin girişi (NextAuth Credentials)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Seçili işler — admin'den kategorili eklenip düzenlenir
model Project {
  id          String   @id @default(cuid())
  title       String
  category    String
  year        String
  description  String  @db.Text
  url         String?  // canlı site linki (varsa)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// "Ne yapıyorum" (Hizmetler) — admin'den eklenip düzenlenir
model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   // cube | cnc | film | share | code | mobile
  color       String   // #e0a94a gibi
  tools       String[] // araçlar (SolidWorks, AutoCAD...)
  order       Int      @default(0)
  published   Boolean  @default(true)
}

// İletişimdeki sosyal/uygulama linkleri — admin'den düzenlenir
model SocialLink {
  id      String  @id @default(cuid())
  name    String  // LinkedIn, Instagram, WhatsApp...
  icon    String  // ikon anahtarı: linkedin | instagram | github | briefcase | whatsapp
  href    String  // link
  order   Int     @default(0)
  enabled Boolean @default(true)
}

// Tekil site içeriği (Hakkımda + iletişim bilgileri) — id = "main"
model SiteContent {
  id             String   @id @default("main")
  aboutKicker    String?  // "Hakkımda"
  aboutTitle     String?  // "Öğrenci ruhu, profesyonel işçilik."
  aboutBody      String?  @db.Text // hakkımda yazısı (bio)
  aboutName      String?  // kod editörü: ad
  aboutSchool    String?  // kod editörü: okul
  aboutLoc       String?  // kod editörü: konum
  aboutComment1  String?  @db.Text // kod editörü: 1. yorum
  aboutComment2  String?  @db.Text // kod editörü: 2. yorum
  aboutComment3  String?  @db.Text // kod editörü: 3. yorum
  aboutVision    String?  @db.Text // kod editörü: vizyonum() return
  aboutStatus    String?  // kod editörü: durum
  contactEmail   String?
  contactPhone   String?
  contactWhatsapp String?
  contactLocation String?
  updatedAt      DateTime @updatedAt
}
